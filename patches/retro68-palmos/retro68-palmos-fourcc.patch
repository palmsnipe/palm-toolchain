--- a/gcc/gcc/c-family/c-lex.cc
+++ b/gcc/gcc/c-family/c-lex.cc
@@ -1820,9 +1820,13 @@ lex_charconst (const cpp_token *token)
       else
         type = char_type_node;
     }
-  /* In C, a character constant has type 'int'.
-     In C++ 'char', but multi-char charconsts have type 'int'.  */
-  else if (!c_dialect_cxx () || chars_seen > 1)
+  /* Palm FourCC constants must remain 32 bits when -mshort makes int
+     16 bits.  */
+  else if (chars_seen > 2)
+    type = long_unsigned_type_node;
+  else if (chars_seen > 1)
+    type = unsigned_type_node;
+  else if (!c_dialect_cxx ())
     type = integer_type_node;
   else
     type = char_type_node;

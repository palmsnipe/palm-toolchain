diff --git a/gcc/libgcc/Makefile.in b/gcc/libgcc/Makefile.in
--- a/gcc/libgcc/Makefile.in
+++ b/gcc/libgcc/Makefile.in
@@ -247,7 +247,7 @@ LIBGCC2_CFLAGS = -O2 $(LIBGCC2_INCLUDES) $(GCC_CFLAGS) $(HOST_LIBGCC2_CFLAGS) \
 		 $(LIBGCC2_DEBUG_CFLAGS) -DIN_LIBGCC2 \
 		 -fbuilding-libgcc -fno-stack-protector \
 		 -ffunction-sections \
-		 $(INHIBIT_LIBC_CFLAGS)
+		 $(INHIBIT_LIBC_CFLAGS) -mpcrel -fpic
 
 # Additional options to use when compiling libgcc2.a.
 # Some targets override this to -isystem include
@@ -442,10 +442,10 @@ lib2funcs = _muldi3 _negdi2 _lshrdi3 _ashldi3 _ashrdi3 _cmpdi2 _ucmpdi2	   \
 	    _negvsi2 _negvdi2 _ctors _ffssi2 _ffsdi2 _clz _clzsi2 _clzdi2  \
 	    _ctzsi2 _ctzdi2 _popcount_tab _popcountsi2 _popcountdi2	   \
 	    _paritysi2 _paritydi2 _powisf2 _powidf2 _powixf2 _powitf2	   \
-	    _mulhc3 _mulsc3 _muldc3 _mulxc3 _multc3 _divhc3 _divsc3	   \
-	    _divdc3 _divxc3 _divtc3 _bswapsi2 _bswapdi2 _clrsbsi2	   \
+	    _bswapsi2 _bswapdi2 _clrsbsi2				   \
 	    _clrsbdi2
 
+# Complex helpers trigger a GCC 9 PIC compiler bug and are unused on Palm OS.
 # The floating-point conversion routines that involve a single-word integer.
 # XX stands for the integer mode.
 swfloatfuncs = $(patsubst %,_fixuns%XX,sf df xf)
diff --git a/gcc/libgcc/config/m68k/lb1sf68.S b/gcc/libgcc/config/m68k/lb1sf68.S
--- a/gcc/libgcc/config/m68k/lb1sf68.S
+++ b/gcc/libgcc/config/m68k/lb1sf68.S
@@ -104,11 +104,11 @@ see the files COPYING3 and COPYING.RUNTIME respectively.  If not, see
 	/* Non PIC (absolute/relocatable) versions */
 
 	.macro PICCALL addr
-	jbsr	\addr
+	bsr	\addr
 	.endm
 
 	.macro PICJUMP addr
-	jmp	\addr
+	bra	\addr
 	.endm
 
 	.macro PICLEA sym, reg
